# Local example only. Replace every credential and secret before starting a shared or production deployment.
POSTGRES_DB=rag
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=ragadmin
MINIO_ROOT_PASSWORD=ragadmin123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=rag-assets
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

RAG_JWT_SECRET=change-this-development-secret-at-least-32-characters
RAG_JWT_TTL_SECONDS=28800
RAG_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
# Base64 for exactly 32 random bytes. Generate with: openssl rand -base64 32
RAG_CREDENTIAL_ACTIVE_KEY_ID=primary
RAG_CREDENTIAL_MASTER_KEY=REPLACE_WITH_BASE64_FOR_32_RANDOM_BYTES
# Comma-separated old decryption-only keys: key-id=base64,key-id-2=base64
RAG_CREDENTIAL_DECRYPTION_KEYS=
RAG_ACTIVE_LANGUAGE_MODEL_PROFILE_ID=
RAG_AUTO_ROUTER_PROFILE=RETRIEVAL_AWARE_50
RAG_MODEL_STRUCTURED_MAX_TOKENS=2200
# Optional for compatible reasoning models: minimal, low, medium, or high.
RAG_MODEL_STRUCTURED_REASONING_EFFORT=
# Optional HTTP proxy used only by model endpoint clients. Internal Compose hosts bypass it.
RAG_MODEL_PROXY_URL=
RAG_MODEL_NO_PROXY_HOSTS=localhost,127.0.0.1,::1,postgres,redis,minio,model-sidecar,parser-sidecar
RAG_AGENTIC_DEEP_READ_STRATEGY=GOAL_BATCHED_PARENT
RAG_EVALUATION_AGENTIC_RETRIEVAL_PARALLELISM=4
RAG_BOOTSTRAP_ADMIN_USERNAME=admin
RAG_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!
RAG_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
RAG_API_PORT=8080
WEB_PORT=5173

MINIO_ENDPOINT=http://localhost:9000
# Browser uploads use presigned /rag-assets URLs through the web server.
# For a public deployment, set this to the public web origin instead.
MINIO_PUBLIC_ENDPOINT=http://localhost:5173
# Worker-side parser URLs stay on the Compose network.
MINIO_WORKER_PUBLIC_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=ragadmin
MINIO_SECRET_KEY=ragadmin123
RAG_STORAGE_CONNECT_TIMEOUT_SECONDS=3
RAG_STORAGE_ATTEMPT_TIMEOUT_SECONDS=10
RAG_STORAGE_REQUEST_TIMEOUT_SECONDS=30

RAG_INGESTION_STREAM=rag:ingestion
RAG_INGESTION_CONSUMER_GROUP=rag-workers
RAG_INGESTION_CONSUMER_NAME=worker-main
RAG_INGESTION_CLAIM_IDLE_MS=30000
RAG_INGESTION_CLAIM_BATCH_SIZE=4
RAG_INGESTION_STALE_AFTER_SECONDS=300
RAG_INGESTION_HEARTBEAT_INTERVAL_SECONDS=30

RAG_EVALUATION_NOTIFICATION_INITIAL_DELAY_MS=15000
RAG_EVALUATION_NOTIFICATION_POLL_MS=10000
RAG_EVALUATION_NOTIFICATION_STALE_AFTER_SECONDS=120
RAG_EVALUATION_NOTIFICATION_CONNECT_TIMEOUT_SECONDS=3
RAG_EVALUATION_NOTIFICATION_REQUEST_TIMEOUT_SECONDS=10
RAG_EVALUATION_NOTIFICATION_ALLOW_PRIVATE_ADDRESSES=false

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

PARSER_SIDECAR_URL=http://parser-sidecar:8090

MODEL_SIDECAR_URL=http://localhost:18091
MODEL_SIDECAR_PORT=18091
MODEL_SIDECAR_GPU=0
BGE_EMBED_MODEL_PATH=/absolute/path/to/models--BAAI--bge-m3/snapshots/REVISION
BGE_RERANK_MODEL_PATH=/absolute/path/to/models--BAAI--bge-reranker-v2-m3/snapshots/REVISION

RAG_GOVERNANCE_EXPIRATION_SCAN_INTERVAL_MS=60000
RAG_GOVERNANCE_VERSION_RETENTION_DAYS=30
RAG_GOVERNANCE_CLEANUP_BATCH_SIZE=50
RAG_GOVERNANCE_CLEANUP_INITIAL_DELAY_MS=120000
RAG_GOVERNANCE_CLEANUP_DELAY_MS=86400000

RAG_INDEX_REBUILD_STALE_AFTER_SECONDS=900
RAG_INDEX_REBUILD_RECOVERY_DELAY_MS=60000

RAG_DEPLOYMENT_ENVIRONMENT=local
RAG_TRACE_SAMPLE_PROBABILITY=0.1
RAG_OTLP_TRACING_ENABLED=false
RAG_OTLP_METRICS_ENABLED=false
RAG_OTLP_LOGGING_ENABLED=false
RAG_OTLP_METRICS_STEP=15s
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics

# Optional observability profile. All published ports default to loopback only.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
TEMPO_PORT=3200
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisGrafanaPassword!
